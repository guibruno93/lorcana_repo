import React, { useState, useEffect } from 'react';
import CardImage from './CardImage';
import './TierListEnhanced.mobile.css';

const API = process.env.REACT_APP_API_URL || 'http://localhost:3002';

export const TierListEnhanced = ({ tierList }) => {
  const [expandedArchetype, setExpandedArchetype] = useState(null);
  const [topCardsCache, setTopCardsCache] = useState({});
  const [loadingCards, setLoadingCards] = useState({});
  
  const tierColors = {
    S: { bg: '#ff4757', glow: 'rgba(255, 71, 87, 0.3)' },
    A: { bg: '#ffa502', glow: 'rgba(255, 165, 2, 0.3)' },
    B: { bg: '#eccc68', glow: 'rgba(236, 204, 104, 0.3)' },
    C: { bg: '#70a1ff', glow: 'rgba(112, 161, 255, 0.3)' },
    D: { bg: '#a4b0be', glow: 'rgba(164, 176, 190, 0.3)' }
  };
  
  const fetchTopCards = async (archetypeName) => {
    if (topCardsCache[archetypeName]) {
      return;
    }
    
    setLoadingCards(prev => ({ ...prev, [archetypeName]: true }));
    
    try {
      const response = await fetch(
        `${API}/api/meta-analysis/archetype/${encodeURIComponent(archetypeName)}/top-cards?limit=8`
      );
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }
      
      const data = await response.json();
      
      setTopCardsCache(prev => ({
        ...prev,
        [archetypeName]: data.topCards || []
      }));
    } catch (error) {
      console.error(`Error fetching top cards for ${archetypeName}:`, error);
    } finally {
      setLoadingCards(prev => ({ ...prev, [archetypeName]: false }));
    }
  };
  
  const toggleArchetype = (archetypeName) => {
    if (expandedArchetype === archetypeName) {
      setExpandedArchetype(null);
    } else {
      setExpandedArchetype(archetypeName);
      fetchTopCards(archetypeName);
    }
  };
  
  if (!tierList) {
    return (
      <div style={{ padding: '40px', textAlign: 'center', color: '#999' }}>
        Loading tier list...
      </div>
    );
  }
  
  return (
    <div style={{ padding: '20px' }}>
      {['S', 'A', 'B', 'C', 'D'].map(tier => {
        const archetypes = tierList[tier] || [];
        if (archetypes.length === 0) return null;
        
        const colors = tierColors[tier];
        
        return (
          <div key={tier} style={{ marginBottom: '32px' }}>
            <div style={{
              background: `linear-gradient(135deg, ${colors.bg} 0%, ${colors.bg}dd 100%)`,
              padding: '16px 24px',
              borderRadius: '12px 12px 0 0',
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              boxShadow: `0 4px 20px ${colors.glow}`
            }}>
              <div style={{
                fontSize: '28px',
                fontWeight: 'bold',
                color: '#fff',
                textShadow: '0 2px 4px rgba(0,0,0,0.3)',
                letterSpacing: '2px'
              }}>
                TIER {tier}
              </div>
              <div style={{
                fontSize: '16px',
                color: 'rgba(255,255,255,0.9)',
                background: 'rgba(0,0,0,0.2)',
                padding: '6px 16px',
                borderRadius: '20px'
              }}>
                {archetypes.length} archetype{archetypes.length !== 1 ? 's' : ''}
              </div>
            </div>
            
            <div style={{
              background: 'rgba(30, 30, 40, 0.6)',
              border: '1px solid rgba(103, 126, 234, 0.3)',
              borderTop: 'none',
              borderRadius: '0 0 12px 12px'
            }}>
              {archetypes.map((archetype, idx) => {
                const isExpanded = expandedArchetype === archetype.archetype;
                const topCards = topCardsCache[archetype.archetype] || [];
                const isLoading = loadingCards[archetype.archetype];
                
                // Normalizar inks para array
                const inksArray = Array.isArray(archetype.inks) 
                  ? archetype.inks 
                  : (archetype.inks || '').split(' ').filter(Boolean);
                
                return (
                  <div key={idx} style={{
                    borderBottom: idx < archetypes.length - 1 ? '1px solid rgba(103, 126, 234, 0.2)' : 'none'
                  }}>
                    <div
                      onClick={() => toggleArchetype(archetype.archetype)}
                      style={{
                        padding: '20px 24px',
                        cursor: 'pointer',
                        transition: 'background 0.2s',
                        background: isExpanded ? 'rgba(103, 126, 234, 0.1)' : 'transparent'
                      }}
                      onMouseEnter={(e) => {
                        if (!isExpanded) {
                          e.currentTarget.style.background = 'rgba(103, 126, 234, 0.05)';
                        }
                      }}
                      onMouseLeave={(e) => {
                        if (!isExpanded) {
                          e.currentTarget.style.background = 'transparent';
                        }
                      }}
                    >
                      <div style={{
                        display: 'flex',
                        justifyContent: 'space-between',
                        alignItems: 'center'
                      }}>
                        <div style={{ flex: 1 }}>
                          <div style={{
                            display: 'flex',
                            alignItems: 'center',
                            gap: '12px',
                            marginBottom: '8px'
                          }}>
                            <span style={{
                              fontSize: '20px',
                              fontWeight: 'bold',
                              color: '#fff'
                            }}>
                              {archetype.archetype}
                            </span>
                            
                            <span style={{
                              fontSize: '16px',
                              fontWeight: 'bold',
                              color: colors.bg,
                              background: 'rgba(0,0,0,0.3)',
                              padding: '4px 12px',
                              borderRadius: '6px'
                            }}>
                              {archetype.power_level}/100
                            </span>
                            
                            <span style={{
                              fontSize: '16px',
                              color: '#667eea',
                              transition: 'transform 0.2s',
                              transform: isExpanded ? 'rotate(180deg)' : 'rotate(0deg)'
                            }}>
                              ▼
                            </span>
                          </div>
                          
                          {inksArray.length > 0 && (
                            <div style={{
                              display: 'flex',
                              gap: '6px',
                              flexWrap: 'wrap'
                            }}>
                              {inksArray.map((ink, j) => (
                                <span key={j} style={{
                                  padding: '4px 10px',
                                  borderRadius: '6px',
                                  fontSize: '12px',
                                  fontWeight: 'bold',
                                  background: getInkColor(ink),
                                  color: '#fff',
                                  textShadow: '0 1px 2px rgba(0,0,0,0.3)'
                                }}>
                                  {ink}
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                        
                        <div style={{
                          display: 'flex',
                          gap: '24px'
                        }}>
                          <div style={{ textAlign: 'center' }}>
                            <div style={{ fontSize: '20px', fontWeight: 'bold', color: '#fff' }}>
                              {archetype.win_rate != null ? archetype.win_rate.toFixed(1) : '0.0'}%
                            </div>
                            <div style={{ fontSize: '12px', color: '#aaa' }}>Win Rate</div>
                          </div>
                          
                          <div style={{ textAlign: 'center' }}>
                            <div style={{ fontSize: '20px', fontWeight: 'bold', color: '#667eea' }}>
                              {archetype.meta_share != null ? archetype.meta_share.toFixed(1) : '0.0'}%
                            </div>
                            <div style={{ fontSize: '12px', color: '#aaa' }}>Meta Share</div>
                          </div>
                        </div>
                      </div>
                    </div>
                    
                    {isExpanded && (
                      <div style={{
                        padding: '24px',
                        background: 'rgba(0,0,0,0.3)',
                        borderTop: '1px solid rgba(103, 126, 234, 0.2)'
                      }}>
                        <div style={{
                          fontSize: '16px',
                          fontWeight: 'bold',
                          color: '#667eea',
                          marginBottom: '16px',
                          display: 'flex',
                          alignItems: 'center',
                          gap: '8px'
                        }}>
                          <span>🃏</span>
                          <span>Top 8 Cards</span>
                          {isLoading && (
                            <span style={{ fontSize: '14px', color: '#999' }}>
                              Loading...
                            </span>
                          )}
                        </div>
                        
                        {topCards.length > 0 ? (
                          <div style={{
                            display: 'grid',
                            gridTemplateColumns: 'repeat(auto-fill, minmax(140px, 1fr))',
                            gap: '16px'
                          }}>
                            {topCards.map((card, cardIdx) => (
                              <div key={cardIdx} style={{
                                background: 'rgba(103, 126, 234, 0.1)',
                                borderRadius: '12px',
                                padding: '12px',
                                border: '1px solid rgba(103, 126, 234, 0.3)',
                                transition: 'all 0.2s'
                              }}
                              onMouseEnter={(e) => {
                                e.currentTarget.style.transform = 'translateY(-4px)';
                                e.currentTarget.style.borderColor = 'rgba(103, 126, 234, 0.6)';
                              }}
                              onMouseLeave={(e) => {
                                e.currentTarget.style.transform = 'translateY(0)';
                                e.currentTarget.style.borderColor = 'rgba(103, 126, 234, 0.3)';
                              }}>
                                <CardImage cardName={card.name} size="small" />
                                
                                <div style={{ marginTop: '12px' }}>
                                  <div style={{
                                    fontSize: '12px',
                                    color: '#fff',
                                    textAlign: 'center',
                                    marginBottom: '6px',
                                    fontWeight: 'bold'
                                  }}>
                                    {card.name.length > 25 ? card.name.substring(0, 22) + '...' : card.name}
                                  </div>
                                  
                                  <div style={{
                                    display: 'flex',
                                    justifyContent: 'space-around',
                                    fontSize: '11px',
                                    color: '#aaa',
                                    paddingTop: '8px',
                                    borderTop: '1px solid rgba(103, 126, 234, 0.2)'
                                  }}>
                                    <div style={{ textAlign: 'center' }}>
                                      <div style={{ color: '#667eea', fontWeight: 'bold' }}>
                                        {card.inclusionRate.toFixed(0)}%
                                      </div>
                                      <div style={{ fontSize: '9px' }}>Inclusion</div>
                                    </div>
                                    
                                    <div style={{ textAlign: 'center' }}>
                                      <div style={{ color: '#fff', fontWeight: 'bold' }}>
                                        {card.avgCopies}
                                      </div>
                                      <div style={{ fontSize: '9px' }}>Avg</div>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            ))}
                          </div>
                        ) : !isLoading && (
                          <div style={{
                            textAlign: 'center',
                            padding: '40px',
                            color: '#999'
                          }}>
                            No card data available
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  );
};

const getInkColor = (ink) => {
  const colors = {
    'Amber': 'linear-gradient(135deg, #f39c12 0%, #e67e22 100%)',
    'Amethyst': 'linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%)',
    'Emerald': 'linear-gradient(135deg, #27ae60 0%, #229954 100%)',
    'Ruby': 'linear-gradient(135deg, #e74c3c 0%, #c0392b 100%)',
    'Sapphire': 'linear-gradient(135deg, #3498db 0%, #2980b9 100%)',
    'Steel': 'linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%)'
  };
  
  return colors[ink] || 'rgba(103, 126, 234, 0.5)';
};

export default TierListEnhanced;
(f)?f.includes(c):c===f,className:d()(s,n,!m(f,c)&&"collapsed")})});b.displayName="AccordionButton";let w=l.forwardRef((e,t)=>{let{as:a="h2","aria-controls":n,bsPrefix:s,className:o,children:i,onClick:l,...c}=e;return s=(0,h.vE)(s,"accordion-header"),(0,r.jsx)(a,{ref:t,...c,className:d()(o,s),children:(0,r.jsx)(b,{onClick:l,"aria-controls":n,children:i})})});w.displayName="AccordionHeader";let x=l.forwardRef((e,t)=>{let{as:a="div",bsPrefix:n,className:s,eventKey:o,...i}=e;n=(0,h.vE)(n,"accordion-item");let c=(0,l.useMemo)(()=>({eventKey:o}),[o]);return(0,r.jsx)(y.Provider,{value:c,children:(0,r.jsx)(a,{ref:t,...i,className:d()(s,n)})})});x.displayName="AccordionItem";let k=l.forwardRef((e,t)=>{let{as:a="div",activeKey:n,bsPrefix:s,className:o,onSelect:i,flush:u,alwaysOpen:m,...f}=(0,c.Ch)(e,{activeKey:"onSelect"}),y=(0,h.vE)(s,"accordion"),g=(0,l.useMemo)(()=>({activeEventKey:n,onSelect:i,alwaysOpen:m}),[n,i,m]);return(0,r.jsx)(p.Provider,{value:g,children:(0,r.jsx)(a,{ref:t,...f,className:d()(o,y,u&&"".concat(y,"-flush"))})})});k.displayName="Accordion";var v=Object.assign(k,{Button:b,Collapse:f,Item:x,Header:w,Body:g}),E=a(94097),j=a(33737),C=a(53873),R=a(29075),H=a(72037),D=a(42918);let A=[{body:(0,r.jsxs)(r.Fragment,{children:["EDHREC is a deck analysis tool for the Commander format (a.k.a. EDH) of Magic: The Gathering. EDHREC computes decklist statistics from popular deck-building websites, helping players new and old build decks of their own.",(0,r.jsx)("br",{}),(0,r.jsx)("br",{}),"Not sure where to get started? Read"," ",(0,r.jsx)(R.Z,{url:"https://edhrec.com/articles/digital-deckbuilding-the-how-to-guide-to-building-a-commander-deck-using-edhrec-archidekt-and-commander-spellbook",utm_medium:"faq",children:"Digital Deckbuilding - The How-to Guide to Building a Commander Deck Using EDHREC, Archidekt and Commander Spellbook"}),"."]}),header:"Help! What is EDHREC?"},{body:(0,r.jsxs)(r.Fragment,{children:["Many cards across EDHREC will have a rating of synergy that will show up as a percentage that either has a + or a - in front of it. For example, this Eldrazi Displacer has a +75% synergy rating on the Rasputin Dreamweaver page. ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"Synergy rating is intended to show cards that are particularly important to the commander or theme you are currently viewing. This is opposed to just cards that are generally played in most decks that are popular because they are individually strong. We did this because we wanted to show what cards were interesting to a commander in the Signature Cards section at the top of the page. It gives a quick look at what cards define a deck, as opposed to just showing a bunch of cards like Cyclonic Rift and Sol Ring that aren’t interesting because they are in a bunch of decks. ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"Synergy score is calculated as: (% decks this card is in for commander/theme) - (% decks this card is in for color identity) ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"In the Eldrazi Displacer and Rasputin Dreamweaver example, a +75% synergy score means that it’s seen way more than in other U/W decks. It’s calculated by taking the 86% of Rasputin decks it is in, then subtracting the 11% of other U/W decks it is in. Leaving us +75% synergy score, making it pretty clear this card is not generally popular in most U/W decks but particularly popular in Rasputin decks."]}),header:'What is "Synergy"? What is the "Signature Cards" section?'},{body:(0,r.jsxs)(r.Fragment,{children:["EDHREC collects deck data from Archidekt, Moxfield, and Scryfall. We collect data daily from these pages and new data is reflected most often on pages within a few days. Tappedout was a source of data in the early stages of the website so some decks may still appear, but we are not collecting data from them currently. ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"If your deck is on one of those deck building sites, chances are it’ll get pulled in. However, there are a number of things that can prevent a deck from being pulled in. Most notably, make sure it’s a legal deck. If you have too many cards, too few cards, cards out of your color identity, or banned cards, our database will not pick it up intentionally. ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"However, there are a number of things that can go wrong between EDHREC and the source websites and there is no way to notify you that something went wrong. Sometimes they may not be your fault, or anyone’s fault. We simply can’t guarantee that every deck makes it up on EDHREC. ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"If you update your deck on the deck building site, EDHREC will collect it as a new deck and delete our old one, effectively updating the deck in our database. Updating your deck a bunch of times does not make duplicates of the deck in our database."]}),header:"Where does EDHREC collect its deck data from? How can I get my deck on EDHREC? What happens when I update my deck?"},{body:(0,r.jsx)(r.Fragment,{children:"EDHREC does not under any circumstances approve of or publish AI-generated articles. This includes but is not limited to ChatGPT, Google Gemini, and other Large Language Models (LLMs) and content generation tools, platforms, and program applications."}),header:"Are EDHREC articles written by AI?"},{body:(0,r.jsxs)(r.Fragment,{children:["On the"," ",(0,r.jsx)(s(),{href:"/themes",target:"_blank",children:"themes page"}),", and the"," ",(0,r.jsx)(s(),{href:"/typal",target:"_blank",children:"typal page"}),", there are dozens of different themes listed. How these are actually defined are not scientific and are simply the developers of EDHREC fiddling with some counts until it appears that the page provides decent results. Each theme also is defined individually and we don’t have one defined formula that covers all themes. ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"As such, we honestly don’t have that good of an answer to this question. We hope the end resulting pages provide some value to people trying to build those themes, but there are plenty of decks that simply didn’t meet the definition but probably could be considered that from a human perspective."]}),header:"How are themes defined? How is typal defined?"},{body:(0,r.jsxs)(r.Fragment,{children:["Salt Scores are based on an annual survey of commander players. Users were showed a card and asked on a scale of 0-4 how salty that card made them. We collected the results and now have"," ",(0,r.jsx)(s(),{href:"/top/salt",target:"_blank",children:"a top list of the saltiest cards"})," ","and also the score appears on cards with a high enough salt score. ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"Read"," ",(0,r.jsx)("a",{href:"https://edhrec.com/articles/new-edhrec-feature-salt/",rel:"noreferrer",target:"_blank",children:"this article"})," ","for more information."]}),header:"What is the Salt Score?"},{body:(0,r.jsxs)(r.Fragment,{children:["We can run custom ad campaigns for companies and individuals that want to target EDHREC users."," ",(0,r.jsx)(s(),{href:"/contact-us",target:"_blank",children:"Contact us"})," ","and we can send over the ad units we have available and some more information on what we can do. ",(0,r.jsx)("br",{})," ",(0,r.jsx)("br",{}),"In general, we will only advertise products that we as EDHREC can stand behind in terms of quality and value. If your product is well known we might be to able to determine the reputation publicly, but if not we may request some samples (we can pay for them if the campaign is large enough) to review them for ourselves. For payment, we are fine with cost per click, cost per impression, and/or affiliate % structures. We’re pretty flexible so just email us!"]}),header:"I have something Commander players might like. Can I advertise on EDHREC?"}];var N=!0,_=()=>{var e;let t=(0,o.useRouter)();return(0,r.jsx)(C.Z,{children:(0,r.jsxs)(E.Z,{children:[(0,r.jsx)(j.AN,{description:"Frequently Asked Questions",keywords:"EDHREC,questions,faq,synergy,data",title:"FAQ | EDHREC"}),(0,r.jsx)(D.Z,{children:"Frequently Asked Questions"}),(0,r.jsx)(H.Z,{children:(0,r.jsx)(v,{className:"mb-3",defaultActiveKey:null===(e=t.query)||void 0===e?void 0:e.q,children:A.map((e,t)=>{let{body:a,header:n}=e;return(0,r.jsxs)(v.Item,{eventKey:"".concat(t),children:[(0,r.jsx)(v.Header,{children:n}),(0,r.jsx)(v.Body,{children:a})]},t)})})})]})})}},12837:function(e){e.exports={panel:"Panel_panel__m9bUZ"}}},function(e){e.O(0,[8189,4883,9577,962,106,2888,9774,179],function(){return e(e.s=50008)}),_N_E=e.O()}]);

    */
})

up.compiler('[data-wheel-scroll]', (el) => {
    const tokens = (el.getAttribute('data-wheel-scroll') || 'x')
        .toLowerCase()
        .split(/\s+/);

    const dir = tokens.includes('y') ? 'y' : 'x';
    const smooth = tokens.includes('smooth');
    const speed = Number(el.getAttribute('data-wheel-speed')) || 1;
    const invert = el.hasAttribute('data-wheel-invert');

    const move = (delta) => {
        const amount = (invert ? -delta : delta) * speed;
        if (dir === 'x') {
            if (smooth && 'scrollBy' in el) {
                el.scrollBy({ left: amount, behavior: 'smooth' });
            } else {
                el.scrollLeft += amount;
            }
        } else {
            if (smooth && 'scrollBy' in el) {
                el.scrollBy({ top: amount, behavior: 'smooth' });
            } else {
                el.scrollTop += amount;
            }
        }
    };

    el.addEventListener('wheel', (evt) => {
        // Only hijack vertical wheel input; let native horizontal scroll pass through
        if (Math.abs(evt.deltaY) > Math.abs(evt.deltaX)) {
            evt.preventDefault(); // required to block page scroll
            move(evt.deltaY);
        }
    }, { passive: false });
});
up.compiler('span[data-linker-target]', (el) => {

    el?.addEventListener('mouseover', e => {

        const anchor = document.createElement('a');
        Array.from(el.attributes).forEach(attr => {
            anchor.setAttribute(attr.name, attr.value);
        });

        base64url = el.getAttribute('data-linker-target');
        url = atob(base64url);

        //change data-linker-target to href
        anchor.href = url;

        //remove data-linker-target
        anchor.removeAttribute('data-linker-target');

        anchor.innerHTML = el.innerHTML;
        el.replaceWith(anchor);
    });

    el?.addEventListener('click', e => {

        //check that we dont have href property
        if (el.hasAttribute('href') !== true) {
            const anchor = document.createElement('a');
            Array.from(el.attributes).forEach(attr => {
                anchor.setAttribute(attr.name, attr.value);
            });

            base64url = el.getAttribute('data-linker-target');
            url = atob(base64url);

            //redirect to url
            window.location.href = url;
        }

    });
});



up.compiler('#decksTable', () => {
    const input = document.getElementById('tableFilter');
    if (!input) return;

    const debouncedFilter = debounce(filterTable, 250);
    input.removeEventListener?.('input', debouncedFilter); // defensive
    input.addEventListener('input', debouncedFilter);

    // immediately apply current value
    if (typeof window.filterTable === 'function') filterTable();
});




(function () {
    const e = { t: Date.now(), s: 0, m: 0, k: 0 };

    addEventListener("scroll", () => e.s = 1, { once: true, passive: true });
    addEventListener("mousemove", () => e.m = 1, { once: true });
    addEventListener("keydown", () => e.k = 1, { once: true });

    setTimeout(() => {
        new Image().src =
            "/img/logo-tiny.png?s=" + e.s +
            "&m=" + e.m +
            "&k=" + e.k +
            "&d=" + (Date.now() - e.t);
    }, 4000);
})();


function loadTomSelect(callback) {
    if (window.TomSelect) {
        callback();
        return;
    }

    // Load CSS if not already included
    if (!document.querySelector('link[href*="tom-select"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = window.tomSelectCss; // Update version if needed
        document.head.appendChild(link);
    }

    // Load JS dynamically
    const script = document.createElement('script');
    script.src = window.tomSelectJs; // Update version if needed
    script.onload = callback;
    document.head.appendChild(script);
}


up.compiler('input[list]', function (input) {
    const datalistId = input.getAttribute('list');
    const datalist = document.getElementById(datalistId);
    if (!datalist) return;

    // Extract options from the datalist
    const options = Array.from(datalist.querySelectorAll('option')).map(opt => ({
        value: opt.value,
        text: opt.textContent || opt.value
    }));

    // Store initial value before TomSelect replaces the input
    const initialValue = input.value;

    // Remove the list attribute so native datalist doesn't interfere
    input.removeAttribute('list');

    // Hide the original datalist
    datalist.style.display = 'none';

    loadTomSelect(function () {
        const ts = new TomSelect(input, {
            options: options,
            valueField: 'value',
            labelField: 'text',
            searchField: ['value', 'text'],
            create: true,
            createOnBlur: true,
            maxItems: 1,
            persist: false,
            closeAfterSelect: true,
            openOnFocus: false,
            dropdownParent: 'body',
            render: {
                option_create() {
                    // Hide the "Add..." prompt - value is created silently on blur
                    return '';
                },
                no_results() {
                    return '';
                }
            },
            onInitialize() {
                // Hide dropdown arrow to look like a regular text input
                this.wrapper.style.cssText += 'background-image: none !important;';
                this.control.style.cssText += 'background-image: none !important; cursor: text;';
                this.wrapper.classList.add('ts-no-caret');

                // Inject CSS once to hide caret and remove extra spacing
                if (!document.getElementById('ts-no-caret-style')) {
                    const style = document.createElement('style');
                    style.id = 'ts-no-caret-style';
                    style.textContent = `
                        .ts-no-caret::after, .ts-no-caret .ts-control::after { display: none !important; }
                        .ts-no-caret.has-items .ts-control > input { width: 0 !important; min-width: 0 !important; padding: 0 !important; }
                        .ts-no-caret .ts-control > .item { margin-right: 0 !important; }
                        .ts-no-caret .ts-control input[role=combobox] { margin-left: 0 !important; }
                    `;
                    document.head.appendChild(style);
                }
            }
        });

        // Restore initial value if it existed
        if (initialValue) {
            // Add as option if not already present
            if (!ts.getOption(initialValue)) {
                ts.addOption({ value: initialValue, text: initialValue });
            }
            ts.setValue(initialValue, true);
        }
    });
});



{
  "name": "inkwell-labs-backend",
  "version": "4.0.0",
  "description": "Inkwell Labs - Premium deck analyzer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "render-build": "bash scripts/render-build-freetier.sh",
    "postinstall": "node scripts/puppeteer-browser-install.cjs",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:auth": "jest auth.test.js",
    "test:decks": "jest decks.test.js",
    "test:tournaments": "jest tournaments.test.js",
    "test:all": "jest --coverage --verbose",
    "smoke:http": "node scripts/smoke-meta-http.js",
    "smoke:http:auth": "node scripts/smoke-meta-http-auth.js",
    "ci:smoke": "npm run smoke:http && npm run smoke:http:auth"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "puppeteer": "^24.40.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.4"
  }
}
